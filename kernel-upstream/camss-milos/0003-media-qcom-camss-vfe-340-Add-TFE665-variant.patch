From 4f65b84ebe3fc2a143c0b67fcfb61b442159d9f1 Mon Sep 17 00:00:00 2001
From: Thomas Colliers <mail@thomascolliers.com>
Date: Sun, 23 Aug 2026 15:41:25 +0200
Subject: [PATCH 3/5] media: qcom: camss: vfe-340: Add TFE665 variant

TFE665 is the TFE found on the Qualcomm milos (SM7635) SoC. It is the
same IP as the TFE530 this file already drives: the TOP reset, register
update and IRQ registers, and the BUS client registers, all sit at the
same offsets relative to their block bases. Three constants differ, and
they are exactly the ones the variant data describes.

Per downstream cam_tfe665.h, TOP is at 0x1800 and BUS at 0x3000, so the
BUS block sits 0x1800 from the TFE base rather than 0xa00 (TFE530 has
TOP at 0x1000 and BUS at 0x1a00).

TFE665 reports a 128-bit RDI bus rather than 64-bit, and downstream
cam_tfe_bus.c picks packer format 0x0 for a 128-bit RDI where it picks
0xa for a 64-bit one. Programming 0xa on TFE665 raises a bus
configuration violation and yields all-zero frames.

The bus has 19 write masters rather than 10. Clients 0 to 9 are the
same ones in the same order, so enum tfe_client stays valid; only the
overflow reporting bound changes, which is why it comes from the
variant data rather than from the enum.

TFE665 also writes RDI rows on a 16-byte boundary, so select the
existing 16-byte bytesperline alignment for CAMSS_7635.

Assisted-by: pi:claude-opus-5
Suggested-by: Jorijn van der Graaf <jorijnvdgraaf@catcrafts.net>
Signed-off-by: Thomas Colliers <mail@thomascolliers.com>
---
 drivers/media/platform/qcom/camss/camss-vfe-340.c | 14 +++++++++++++-
 drivers/media/platform/qcom/camss/camss-vfe.c     |  2 ++
 drivers/media/platform/qcom/camss/camss.h         |  1 +
 3 files changed, 16 insertions(+), 1 deletion(-)

diff --git a/drivers/media/platform/qcom/camss/camss-vfe-340.c b/drivers/media/platform/qcom/camss/camss-vfe-340.c
index 92279d827635..30251cf41cfd 100644
--- a/drivers/media/platform/qcom/camss/camss-vfe-340.c
+++ b/drivers/media/platform/qcom/camss/camss-vfe-340.c
@@ -72,6 +72,7 @@ static const struct tfe_variant *tfe_variant(struct vfe_device *vfe);
 #define TFE_BUS_IMAGE_CFG_2(vfe, c)			BUS_REG(vfe, 0x214 + (c) * 0x100)
 #define		TFE_BUS_IMAGE_CFG_2_DEFAULT	0xffff
 #define TFE_BUS_PACKER_CFG(vfe, c)			BUS_REG(vfe, 0x218 + (c) * 0x100)
+#define		TFE_BUS_PACKER_CFG_FMT_PLAIN128	0x0
 #define		TFE_BUS_PACKER_CFG_FMT_PLAIN8	0x1
 #define		TFE_BUS_PACKER_CFG_FMT_PLAIN64	0xa
 #define		TFE_BUS_PACKER_CFG_FMT_MIPI10	0xc
@@ -95,9 +96,20 @@ static const struct tfe_variant tfe530_variant = {
 	.num_clients = 10,
 };
 
+static const struct tfe_variant tfe665_variant = {
+	.bus_base = 0x1800,
+	.rdi_packer_fmt = TFE_BUS_PACKER_CFG_FMT_PLAIN128,
+	.num_clients = 19,
+};
+
 static const struct tfe_variant *tfe_variant(struct vfe_device *vfe)
 {
-	return &tfe530_variant;
+	switch (vfe->camss->res->version) {
+	case CAMSS_7635:
+		return &tfe665_variant;
+	default:
+		return &tfe530_variant;
+	}
 }
 
 enum tfe_client {
