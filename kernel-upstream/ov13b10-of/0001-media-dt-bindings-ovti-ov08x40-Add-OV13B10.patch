From a986322b5f54e07cf89febb696963fab88b3aa22 Mon Sep 17 00:00:00 2001
From: Thomas Colliers <mail@thomascolliers.com>
Date: Sun, 16 Aug 2026 20:30:35 +0200
Subject: [PATCH 1/3] media: dt-bindings: ovti,ov08x40: Add OV13B10

The OV13B10 uses the same clock, three supply and active-low reset
properties as the OV08X40, with a two- or four-lane CSI-2 interface.
Document it in the existing OV08X40 binding rather than adding a separate
schema.

An earlier OV13B10 binding proposal by Antoine Bernard received a request
to extend the existing binding. Follow that approach while requiring the
three supplies and a 560 MHz link frequency only for OV13B10. Preserve the
existing OV08X40 constraints, including its lane numbering and optional
supplies.

Keep the OV13B10 lane-count constraint independent of lane indices so
that the zero-based mapping used on the Fairphone 6 remains valid. Add an
OV13B10 example and associate its MAINTAINERS entry with the shared file.

Link: https://lore.kernel.org/r/10d6863d-7c66-47ad-a683-251f2a40af66@kernel.org/
Cc: Antoine Bernard <zalnir@proton.me>
Assisted-by: pi:claude-opus-5
Signed-off-by: Thomas Colliers <mail@thomascolliers.com>
---
 .../bindings/media/i2c/ovti,ov08x40.yaml      | 96 ++++++++++++++++---
 MAINTAINERS                                   |  1 +
 2 files changed, 85 insertions(+), 12 deletions(-)

diff --git a/Documentation/devicetree/bindings/media/i2c/ovti,ov08x40.yaml b/Documentation/devicetree/bindings/media/i2c/ovti,ov08x40.yaml
index 552efdf8934f..fc2a5355e285 100644
--- a/Documentation/devicetree/bindings/media/i2c/ovti,ov08x40.yaml
+++ b/Documentation/devicetree/bindings/media/i2c/ovti,ov08x40.yaml
@@ -5,10 +5,11 @@
 $id: http://devicetree.org/schemas/media/i2c/ovti,ov08x40.yaml#
 $schema: http://devicetree.org/meta-schemas/core.yaml#
 
-title: Omnivision OV08X40 CMOS Sensor
+title: OmniVision OV08X40 and OV13B10 CMOS sensors
 
 maintainers:
   - Bryan O'Donoghue <bryan.odonoghue@linaro.org>
+  - Thomas Colliers <mail@thomascolliers.com>
 
 description: |
   The Omnivision OV08X40 is a 9.2 megapixel, CMOS image sensor which supports:
@@ -21,12 +22,60 @@ description: |
   - Dynamic defect pixel cancellation
   - Standard SCCB command interface
 
+  The OmniVision OV13B10 is a 13-megapixel CMOS image sensor with a
+  4208x3120 active pixel array. It uses a 19.2 MHz external clock and
+  transmits image data through a two- or four-lane MIPI CSI-2 interface.
+
 allOf:
   - $ref: /schemas/media/video-interface-devices.yaml#
+  - if:
+      properties:
+        compatible:
+          const: ovti,ov13b10
+    then:
+      properties:
+        reset-gpios:
+          maxItems: 1
+        port:
+          properties:
+            endpoint:
+              properties:
+                link-frequencies:
+                  items:
+                    - const: 560000000
+          required:
+            - endpoint
+      required:
+        - avdd-supply
+        - dovdd-supply
+        - dvdd-supply
+    else:
+      properties:
+        port:
+          properties:
+            endpoint:
+              additionalProperties: false
+              properties:
+                data-lanes:
+                  oneOf:
+                    - items:
+                        - const: 1
+                        - const: 2
+                    - items:
+                        - const: 1
+                        - const: 2
+                        - const: 3
+                        - const: 4
+                link-frequencies: true
+                remote-endpoint: true
+              required:
+                - remote-endpoint
 
 properties:
   compatible:
-    const: ovti,ov08x40
+    enum:
+      - ovti,ov08x40
+      - ovti,ov13b10
 
   reg:
     maxItems: 1
@@ -53,26 +102,21 @@ properties:
     properties:
       endpoint:
         $ref: /schemas/media/video-interfaces.yaml#
-        additionalProperties: false
+        unevaluatedProperties: false
 
         properties:
           data-lanes:
             oneOf:
-              - items:
-                  - const: 1
-                  - const: 2
-              - items:
-                  - const: 1
-                  - const: 2
-                  - const: 3
-                  - const: 4
+              - minItems: 2
+                maxItems: 2
+              - minItems: 4
+                maxItems: 4
           link-frequencies: true
           remote-endpoint: true
 
         required:
           - data-lanes
           - link-frequencies
-          - remote-endpoint
 
 required:
   - compatible
@@ -117,4 +161,32 @@ examples:
             };
         };
     };
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        camera@36 {
+            compatible = "ovti,ov13b10";
+            reg = <0x36>;
+
+            clocks = <&camera_clk>;
+
+            avdd-supply = <&camera_avdd_2v8>;
+            dovdd-supply = <&camera_dovdd_1v8>;
+            dvdd-supply = <&camera_dvdd_1v1>;
+
+            reset-gpios = <&gpio 41 GPIO_ACTIVE_LOW>;
+
+            port {
+                ov13b10_out: endpoint {
+                    remote-endpoint = <&csi_in>;
+                    data-lanes = <0 1 2 3>;
+                    link-frequencies = /bits/ 64 <560000000>;
+                };
+            };
+        };
+    };
 ...
diff --git a/MAINTAINERS b/MAINTAINERS
index 3785b8c1de0a..a2d63c8e9f58 100644
--- a/MAINTAINERS
+++ b/MAINTAINERS
@@ -19966,6 +19966,7 @@ M:	Arec Kao <arec.kao@intel.com>
 L:	linux-media@vger.kernel.org
 S:	Maintained
 T:	git git://linuxtv.org/media.git
+F:	Documentation/devicetree/bindings/media/i2c/ovti,ov08x40.yaml
 F:	drivers/media/i2c/ov13b10.c
 
 OMNIVISION OV2680 SENSOR DRIVER
